model Campaign {
  id          String  @id @default(uuid())
  name        String
  description String?

  notes   String?
  dmNotes String?

  active    Boolean @default(true)
  completed Boolean @default(false)
  archived  Boolean @default(false)

  ownerId String     @db.Text
  owner   users_sync @relation("CampaignOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dms     users_sync[] @relation("CampaignDMs")
  players users_sync[] @relation("CampaignPlayers")

  npcs            Npc[]            @relation("CampaignNpcs")
  sessions        GameSession[]
  playerParties   PlayerParty[]    @relation("CampaignPlayerParties")
  campaignInvites CampaignInvite[]

  @@schema("public")
}

model PlayerParty {
  id          String  @id @default(uuid())
  name        String
  description String?
  notes       String?
  dmNotes     String?

  active   Boolean @default(true)
  archived Boolean @default(false)

  ownerId String     @db.Text
  owner   users_sync @relation("PartyOwner", fields: [ownerId], references: [id])

  campaigns  Campaign[]  @relation("CampaignPlayerParties")
  characters Character[]

  @@schema("public")
}

model GameSession {
  id       String   @id @default(uuid())
  date     DateTime
  notes    String?
  dmNotes  String?
  archived Boolean  @default(false)

  campaignId String
  campaign   Campaign    @relation(fields: [campaignId], references: [id])
  encounters Encounter[]

  @@schema("public")
}

model Encounter {
  id          String  @id @default(uuid())
  name        String
  description String?
  notes       String?
  dmNotes     String?
  loot        String?
  difficulty  String?

  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id])

  npcs Npc[] @relation("EncounterNpcs")

  @@schema("public")
}

enum CampaignInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED

  @@schema("public")
}

model CampaignInvite {
  id String @id @default(uuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  inviterId String     @db.Text
  inviter   users_sync @relation("CampaignInviteInviter", fields: [inviterId], references: [id])

  inviteeId String     @db.Text
  invitee   users_sync @relation("CampaignInviteInvitee", fields: [inviteeId], references: [id])

  status CampaignInviteStatus @default(PENDING)
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, inviteeId])
  @@index([inviteeId])
  @@schema("public")
}

enum PlayerConnectionStatus {
  PENDING
  ACCEPTED
  BLOCKED

  @@schema("public")
}

model PlayerConnection {
  id String @id @default(uuid())

  requesterId String     @db.Text
  requester   users_sync @relation("PlayerConnectionRequester", fields: [requesterId], references: [id])

  addresseeId String     @db.Text
  addressee   users_sync @relation("PlayerConnectionAddressee", fields: [addresseeId], references: [id])

  status PlayerConnectionStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@schema("public")
}
